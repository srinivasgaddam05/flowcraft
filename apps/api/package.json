{
  "name": "@workflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:demo": "DEMO_MODE=true tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DEMO_MODE=true tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/platform-ws": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/websockets": "^11.0.11",
    "@prisma/client": "^6.7.0",
    "@flowcraft/engine": "*",
    "@workflow/shared-types": "*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.52.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.1",
    "js-yaml": "^5.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.3"
  }
}
