{
  "name": "workflow-creator",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @workflow/api\" \"npm run dev --workspace @workflow/web\"",
    "dev:demo": "concurrently \"npm run dev:demo --workspace @workflow/api\" \"npm run dev --workspace @workflow/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "db:deploy": "prisma migrate deploy",
    "worker": "npm run worker --workspace @workflow/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prisma": "^6.7.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^5.4.3"
  }
}
